# Bottled Treasures — environment variables
# Copy this file to `.env` and fill in every REQUIRED value before deploying.
# Never commit your real `.env`.

# ---------------------------------------------------------------------------
# Owner login for the dashboard at /admin   (REQUIRED in production)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=official@bottledtreasures.ng
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign the login cookie   (REQUIRED in production)
# Use a long random value, e.g. the output of:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Where orders, payment receipts and uploaded product photos are stored.
# In Docker this is /app/data (a named volume); locally it defaults to ./data
# DATA_DIR=/app/data

# The login cookie only works over HTTPS in production. Leave this unset when the site
# is served over https:// (recommended). Set it to false ONLY if you must open the
# dashboard over plain http:// (for example http://your-server-ip:3000).
# COOKIE_SECURE=false

# Port the app listens on inside the container (the app runs on 3000).
# PORT=3000

# Port exposed on the host by docker compose (defaults to 3000).
# HOST_PORT=3000
